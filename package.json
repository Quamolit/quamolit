{
  "version": "0.0.18-alpha.1",
  "dependencies": {
    "@calcit/procs": "0.19.1",
    "@quamolit/touch-control": "^0.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "bottom-tip": "^0.1.5",
    "vite": "^8.0.12"
  },
  "scripts": {
    "compile": "caps --ci && calcit calcit.cirru js",
    "test:clock": "calcit test --tag frame-clock --require-match",
    "test:runtime": "node test/runtime-smoke.mjs",
    "test:fixtures": "node --test test/m0/fixtures.test.mjs",
    "test:bench": "node --test test/m0/bench-metrics.test.mjs",
    "bench": "node test/m0/bench.mjs",
    "test:visual": "caps --ci && yarn compile:visual && playwright test --config test/m0/playwright.config.mjs",
    "compile:visual": "calcit --init-fn quamolit.test.frame-fixture/main! --reload-fn quamolit.test.frame-fixture/reload! calcit.cirru js",
    "release": "yarn vite build --base=./"
  },
  "packageManager": "yarn@4.12.0"
}
